FROM registry.access.redhat.com/ubi9/nodejs-22 AS builder

USER 0

RUN dnf install -y --disablerepo='*' --enablerepo='ubi-*' git && dnf clean all

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then GCLOUD_ARCH="arm"; else GCLOUD_ARCH="x86_64"; fi && \
    curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-${GCLOUD_ARCH}.tar.gz" \
      | tar -xz -C /usr/lib

ARG OPENCHAMBER_VERSION=2.1.0
ARG OPENCODE_VERSION=1.18.34
RUN npm install -g "@openchamber/web@${OPENCHAMBER_VERSION}" "opencode-ai@${OPENCODE_VERSION}"

COPY shared/bashrc.sh /usr/local/bin/shared-bashrc.sh
COPY shared/discover-models.sh /usr/local/bin/shared-discover-models.sh
COPY openchamber/entrypoint.sh /usr/local/bin/openchamber-entrypoint.sh
COPY openchamber/entrypoint-init-container.sh /entrypoint-init-container.sh

RUN chgrp -R 0 /opt/app-root && \
    chmod -R g=u /opt/app-root && \
    chmod g=u /etc/passwd

USER 1001

CMD ["/openchamber/entrypoint.sh"]
