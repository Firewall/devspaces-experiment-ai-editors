FROM registry.access.redhat.com/ubi9/nodejs-24 AS builder

USER 0

RUN dnf install -y --disablerepo='*' --enablerepo='ubi-*' git && dnf clean all

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then GCLOUD_ARCH="arm"; else GCLOUD_ARCH="x86_64"; fi && \
    curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-${GCLOUD_ARCH}.tar.gz" \
      | tar -xz -C /usr/lib

# OpenChamber 2.x drives the OpenCode 2.x CLI and rejects the legacy 1.x
# opencode-ai package, so install @opencode/cli, which ships the same
# `opencode` binary from a per-platform package. Its postinstall links that
# binary over bin/opencode.exe, so run it explicitly instead of depending on
# npm's lifecycle-script policy. 2.5.3 declares engines >= 24.14 and runs on
# the image's Node.js 22.
ARG OPENCHAMBER_VERSION=2.5.3
ARG OPENCODE_VERSION=2.2.4
RUN npm install -g --ignore-scripts \
      "@openchamber/web@${OPENCHAMBER_VERSION}" "@opencode/cli@${OPENCODE_VERSION}" && \
    node "$(npm root -g)/@opencode/cli/postinstall.mjs" && \
    opencode --version

COPY shared/runtime.sh /usr/local/bin/shared-runtime.sh
COPY shared/bashrc.sh /usr/local/bin/shared-bashrc.sh
COPY shared/discover-models.sh /usr/local/bin/shared-discover-models.sh
COPY openchamber/redhat-dark.json /opt/openchamber/redhat-dark.json
COPY openchamber/entrypoint.sh /usr/local/bin/openchamber-entrypoint.sh
COPY openchamber/entrypoint-init-container.sh /entrypoint-init-container.sh

RUN chgrp -R 0 /opt/app-root && \
    chmod -R g=u /opt/app-root && \
    chmod g=u /etc/passwd

USER 1001

CMD ["/openchamber/entrypoint.sh"]
