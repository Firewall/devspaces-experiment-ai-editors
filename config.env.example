# --- T3 Code ---
T3_IMAGE=quay.io/my-org/devspaces-t3-code-editor:latest

# --- OpenChamber ---
OPENCHAMBER_IMAGE=quay.io/my-org/devspaces-openchamber-editor:latest
# OPENCHAMBER_UI_PASSWORD=my-password  # auto-generated if omitted

# --- Orca ---
ORCA_IMAGE=quay.io/my-org/devspaces-orca-editor:latest
# ORCA_PAIRING_ADDRESS=wss://orca.example.com/  # for manual editor registration; deploy.sh sets this

# --- VS Code Agent Host ---
AGENT_HOST_IMAGE=quay.io/my-org/devspaces-vs-code-agent-host:latest

# --- Shared ---
# Required: your Dev Spaces user namespace, for example rh-ee-yourname-dev.
# Use `oc project -q` to check the current namespace before setting this.
NAMESPACE=
# Optional: KServe model namespace for all editors. Leave empty to skip discovery.
# Workspace service accounts need access to this namespace and its model endpoints.
REDHAT_AI_NAMESPACE=
# Optional: leave empty unless you use Google Vertex AI.
GOOGLE_CLOUD_PROJECT=
CLOUD_ML_REGION=us-central1
